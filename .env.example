APP_NAME="Stocky"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
APP_TIMEZONE="UTC"

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stocky
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=database

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SAAS_ADMIN_EMAIL=admin@example.com
SAAS_ADMIN_PASSWORD=

SAAS_BASE_DOMAIN=localhost
SAAS_TENANT_SCHEME=http

SAAS_CENTRAL_DATABASE=stocky
SAAS_CENTRAL_USERNAME=root
SAAS_CENTRAL_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8000,localhost:8000,nfc.localhost:8000

TENANT_DB_PREFIX=stocky_tenant_
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306

TENANT_DB_PROVISION_MODE=manual

TENANT_PROVISION_DB_HOST=127.0.0.1
TENANT_PROVISION_DB_PORT=3306
TENANT_PROVISION_DB_USER=root
TENANT_PROVISION_DB_PASS=
